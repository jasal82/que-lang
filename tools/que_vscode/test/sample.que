// -- Pattern Matching ---------------------------------------------------------

match version {
    v">=2.0.0" => println("v2+"),
    v">=1.0.0" => println("v1"),
    _           => println("old"),
}

match result {
    Ok(val)  => println("success: " + str(val)),
    Err(e)   => println("error: " + str(e)),
}

// -- Types --------------------------------------------------------------------

type FilePair = (Path, Path)
type BuildFn = fn(Path) -> Result<Path, String>

type Service = {
    name: String,
    image: String,
    port: Int,
    env: Map<String, String>,
}

enum DeployTarget {
    Kubernetes { cluster: String, namespace: String },
    Docker { host: String },
    Local,
}

// -- Tasks --------------------------------------------------------------------

@description("Remove build artifacts")
task clean {
    if exists(path("./build")) {
        path("./build").delete()
        println("cleaned")
    }
}

@description("Build the project")
@deps([clean])
@inputs([g"src/**/*.que"])
@outputs([path("./build/output.txt")])
task build {
    let content = fs.read(path("./src/main.que")).unwrap()
    fs.write(path("./build/output.txt"), content)
    println("built")
}

// -- Pipe & Functional --------------------------------------------------------

let result = [1, 2, 3, 4, 5]
    .filter(|x| x > 2)
    .map(|x| x * x)
    .fold(0, |acc, x| acc + x)

let items = sources
    .map(fs.read)
    .map(|r| r.unwrap())

// -- Guard / Defer / Try ------------------------------------------------------

guard exists(path("./Cargo.toml")) else {
    fail("must be run from project root")
}

defer println("cleanup done")

try {
    `cargo build`.runChecked()?
} catch e {
    println("build failed: " + str(e))
}

